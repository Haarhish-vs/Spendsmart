NODE_ENV=development
PORT=5000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Custom JWT Authentication
JWT_SECRET=your_super_strong_cryptographic_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d

GROQ_API_KEY=

# Firebase Admin SDK (Option A: Single JSON string, recommended for Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"spendsmart-48848",...}

# Firebase Admin SDK (Option B: Individual Environment Variables)
FIREBASE_PROJECT_ID=spendsmart-48848
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

YOUTUBE_API_KEY=
